# Unity scenes, prefabs and assets are text (Force Text serialization); keep line endings stable.
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.meta       text eol=lf
*.cs         text diff=csharp
*.py         text

# Very large binary sources go through Git LFS (GitHub rejects files over 100 MB).
# Everyone must run `git lfs install` once (GitHub Desktop does this automatically).
*.psd  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text

# Other binaries: stored normally, just never diffed/merged as text.
*.fbx  binary
*.obj  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.task binary
*.pdf  binary
